# [TIDAK DIJALANKAN — KONTROL NEGATIF, 4 Agustus 2026]
# Preset ini mengecilkan chunk 8000->3500 agar prompt muat di n_ctx 4096.
# Terukur kemudian: model dimuat pada n_ctx 8192 dan prompt preset A hanya
# 5.003 token, jadi pengecilan itu tak pernah diperlukan — dan justru
# memangkas jangkauan pembacaan (coverage median 0,98 -> 0,42 pada B).
# Digantikan preset E. Disimpan sebagai rekaman rancangan yang ditolak.
#
# PRESET D — seperti preset C, ditambah Reviewer Agent aktif
#
# Tujuan ablasi: mengukur kontribusi Reviewer Agent (loop debat multi-agent).
# Beda dari preset C HANYA pada satu baris (ditandai <== BEDA DARI C):
#   REVIEWER_ENABLE  false -> true
#
# BIAYA: tiap laporan mendapat 1-2 panggilan reviewer tambahan, dan setiap
# penolakan reviewer memicu SELURUH tactic+technique agent berjalan ulang
# (hingga LLM_REVIEW_MAX_ITER kali). Pada preset C yang sudah 12 chunk, satu
# putaran revisi berarti sampai 12 panggilan technique agent tambahan — durasi
# preset D bisa jauh melebihi C. Bila melewati 3 jam, hentikan dan laporkan.

# --- Server & model ---
LLM_PROVIDER=lmstudio
LOCAL_LLM_BASE_URL=http://localhost:1234
LOCAL_LLM_MODEL=qwen/qwen3-4b
LOCAL_LLM_API_KEY=
LLM_DISABLE_THINKING=true
LLM_REASONING_EFFORT=none
LLM_STRUCTURED_OUTPUT=true
LOCAL_LLM_MAX_TOKENS_TECHNIQUE=512
LOCAL_LLM_MAX_TOKENS_TACTIC=512
LOCAL_LLM_MAX_TOKENS_REVIEWER=512

# --- Anggaran context window ---
# TERUKUR 4 Agustus 2026 lewat GET /api/v0/models: qwen/qwen3-4b dimuat
# dengan loaded_context_length=8192 (bukan 4096 seperti komentar usang di
# bagian bawah .env). Diverifikasi empiris: prompt 5.003 token diterima,
# 8.812 token ditolak 'exceeds the available context size'.
LLM_N_CTX=8192
# Rasio char/token terukur dari usage.prompt_tokens server: 19.740 char =
# 5.003 token = 3,95 char/token (default kode 3,5 melebih-lebihkan ~13%).
PROMPT_BUDGET_CHARS_PER_TOKEN=3.95
PROMPT_BUDGET_ENFORCE=true

# --- Ukuran prompt & jangkauan pembacaan ---
LOCAL_LLM_REPORT_MAX_CHARS=3500
LLM_CHUNK_OVERLAP_CHARS=250
LLM_MAX_CHUNKS=12
CANDIDATE_LIST_MAX_CHARS=4500
CANDIDATE_DESC_CHARS=160
TECHNIQUE_CANDIDATE_TOP_K=50
LOCAL_LLM_CANDIDATE_TOP_K=50

# --- Retrieval ---
RETRIEVAL_MAX_CHARS=80000
RETRIEVAL_PER_CHUNK=true
RETRIEVAL_NAME_BOOST=true
RETRIEVAL_EXCLUDE_PRECOMPROMISE=true
RETRIEVAL_EMBEDDING_HYBRID=true
RETRIEVAL_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
RETRIEVAL_EMBEDDING_ALPHA=0.5
RETRIEVAL_DOC_DESC_CHARS=1000
ATTCK_DESC_MAX_CHARS=1000
TECHNIQUE_INCLUDE_SUBTECHNIQUES=true

# --- Rekonsiliasi & filter ---
TECHNIQUE_ACCEPT_TOP_N=30
RECONCILE_TACTIC_FILTER=false
RECONCILE_SUBTECH_FAMILY_CAP=2

# --- Reviewer ---
REVIEWER_ENABLE=true
LLM_REVIEW_MAX_ITER=2
LLM_REVISE_TEMPERATURE=0.4

# --- Sumber data ---
ATTCK_SOURCE=data/mitre_cti/enterprise-attack.json
